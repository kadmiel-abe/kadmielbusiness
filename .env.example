# ==========================================
# CONFIGURATION SUPABASE
# ==========================================
# URL de votre projet Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Clé Secrète SERVICE ROLE (NE JAMAIS EXPOSER CÔTÉ CLIENT)
# Utilisée uniquement dans les routes d'API pour contourner les règles RLS
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ==========================================
# CONFIGURATION GENIUSPAY (Côte d'Ivoire)
# ==========================================
# Vos identifiants de marchand fournis par le dashboard GeniusPay
GENIUSPAY_API_KEY=votre_cle_api_geniuspay
GENIUSPAY_API_SECRET=votre_cle_secrete_geniuspay

# Clé secrète de signature des webhooks (ex: whsec_...)
GENIUSPAY_WEBHOOK_SECRET=votre_cle_secrete_webhook

# (Optionnel) Base URL de l'API GeniusPay si changement d'environnement
# GENIUSPAY_BASE_URL=https://geniuspay.ci/api/v1/merchant/payments

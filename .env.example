# URL publique de l'application, utilisée pour composer les liens de paiement.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Configuration Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Serveur uniquement — ne jamais préfixer cette clé par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Configuration GeniusPay — clés exclusivement côté serveur.
# Le mode mock sera utilisé lors de la phase D.
GENIUSPAY_MODE=mock
GENIUSPAY_API_KEY=
GENIUSPAY_SECRET_KEY=
GENIUSPAY_WEBHOOK_SECRET=

# Compatibilité avec l'API actuelle jusqu'à son remplacement en phase D.
GENIUSPAY_API_SECRET=

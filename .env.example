# ==========================================
# KADMIEL BUSINESS PAY - ENV TEMPLATE
# ==========================================

# 1. URL publique de l'application (ex: https://kadmielbusiness.vercel.app en prod)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 2. Configuration Supabase (Projet Cloud)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Clé secrète Service Role (Serveur uniquement - bypass RLS)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 3. Configuration GeniusPay (Passerelle Mobile Money Côte d'Ivoire)
GENIUSPAY_API_KEY=pk_live_your_key
GENIUSPAY_API_SECRET=sk_live_your_secret
GENIUSPAY_WEBHOOK_SECRET=whsec_your_webhook_secret

# 4. (Optionnel) Configuration SMTP pour envoi automatique des reçus par email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="Kadmiel Business Pay <paiements@kadmielbusiness.ci>"
